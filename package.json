{
  "name": "parallel-zukan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/optimize-dist.mjs",
    "preview": "vite preview",
    "video:preview": "remotion preview remotion/index.tsx",
    "video:render": "remotion render remotion/index.tsx PromoVideo out/video.mp4",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@remotion/player": "4.0.526",
    "@remotion/zod-types": "4.0.526",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "4.0.526",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.526",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
